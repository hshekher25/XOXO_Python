# XOXO Backend Environment Variables
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=xoxo_db

# JWT Security (IMPORTANT: Change in production!)
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (OPTIONAL - leave empty to disable)
# Redis is used for location caching. Nearby features work without it but may be slower.
REDIS_URL=

# S3/MinIO Configuration (OPTIONAL - leave empty to disable photo uploads)
# Photo upload endpoints will return error if not configured
S3_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=xoxo-images
S3_REGION=us-east-1

# Location Settings
NEARBY_RADIUS_KM=10

